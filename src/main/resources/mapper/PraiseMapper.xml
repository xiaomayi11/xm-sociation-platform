<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.PraiseMapper">

    <select id="selectAll" resultType="com.example.entity.Praise">
        select * from `praise`
        <where>
            <if test="userId != null"> and praise.user_id = #{userId}</if>
            <if test="dynamicId != null"> and praise.dynamic_id = #{dynamicId}</if>
        </where>
        order by id desc
    </select>

    <delete id="deleteById">
        delete from `praise`
        where id = #{id}
    </delete>

    <insert id="insert" parameterType="com.example.entity.Praise" useGeneratedKeys="true">
        insert into `praise`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null">user_id,</if>
            <if test="dynamicId != null">dynamic_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="dynamicId != null">#{dynamicId},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.Praise">
        update `praise`
        <set>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="dynamicId != null">
                dynamic_id = #{dynamicId},
            </if>
        </set>
        where id = #{id}
    </update>

</mapper>