<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.CertificationApplyMapper">

    <select id="selectAll" resultType="com.example.entity.CertificationApply">
        select ca.*, u.name as user_name
        from `certification_apply` ca
        left join `user` u on ca.user_id = u.id
        <where>
            <if test="certificationId != null"> and ca.certification_id = #{certificationId}</if>
            <if test="userId != null"> and ca.user_id = #{userId}</if>
            <if test="status != null and status != ''"> and ca.status = #{status}</if>
        </where>
        order by ca.id desc
    </select>

    <select id="selectById" resultType="com.example.entity.CertificationApply">
        select ca.*, u.name as user_name
        from `certification_apply` ca
        left join `user` u on ca.user_id = u.id
        where ca.id = #{id}
    </select>

    <delete id="deleteById">
        delete from `certification_apply` where id = #{id}
    </delete>

    <delete id="deleteBatch">
        delete from `certification_apply` where id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <insert id="insert" parameterType="com.example.entity.CertificationApply" useGeneratedKeys="true">
        insert into `certification_apply`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="certificationId != null">certification_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="time != null">time,</if>
            <if test="status != null">status,</if>
            <if test="score != null">score,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="certificationId != null">#{certificationId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="time != null">#{time},</if>
            <if test="status != null">#{status},</if>
            <if test="score != null">#{score},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.CertificationApply">
        update `certification_apply`
        <set>
            <if test="certificationId != null">certification_id = #{certificationId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="time != null">time = #{time},</if>
            <if test="status != null">status = #{status},</if>
            <if test="score != null">score = #{score},</if>
        </set>
        where id = #{id}
    </update>
</mapper>