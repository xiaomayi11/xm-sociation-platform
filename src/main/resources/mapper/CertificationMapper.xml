<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.CertificationMapper">

    <select id="selectAll" resultType="com.example.entity.Certification">
        select c.*,
               (select count(*) from certification_apply where certification_id = c.id) as apply_count
        from `certification` c
        <where>
            <if test="title != null"> and c.title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''"> and c.status = #{status}</if>
        </where>
        order by c.id desc
    </select>

    <select id="selectById" resultType="com.example.entity.Certification">
        select c.*,
               (select count(*) from certification_apply where certification_id = c.id) as apply_count
        from `certification` c
        where c.id = #{id}
    </select>

    <delete id="deleteById">
        delete from `certification` where id = #{id}
    </delete>

    <delete id="deleteBatch">
        delete from `certification` where id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <insert id="insert" parameterType="com.example.entity.Certification" useGeneratedKeys="true">
        insert into `certification`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="title != null">title,</if>
            <if test="description != null">description,</if>
            <if test="examTime != null">exam_time,</if>
            <if test="location != null">location,</if>
            <if test="maxParticipants != null">max_participants,</if>
            <if test="img != null">img,</if>
            <if test="status != null">status,</if>
            <if test="applyCount != null">apply_count,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="title != null">#{title},</if>
            <if test="description != null">#{description},</if>
            <if test="examTime != null">#{examTime},</if>
            <if test="location != null">#{location},</if>
            <if test="maxParticipants != null">#{maxParticipants},</if>
            <if test="img != null">#{img},</if>
            <if test="status != null">#{status},</if>
            <if test="applyCount != null">#{applyCount},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.Certification">
        update `certification`
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            <if test="examTime != null">exam_time = #{examTime},</if>
            <if test="location != null">location = #{location},</if>
            <if test="maxParticipants != null">max_participants = #{maxParticipants},</if>
            <if test="img != null">img = #{img},</if>
            <if test="status != null">status = #{status},</if>
            <if test="applyCount != null">apply_count = #{applyCount},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </set>
        where id = #{id}
    </update>
</mapper>