<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.OperationLogMapper">

    <select id="selectAll" resultType="com.example.entity.OperationLog">
        select * from `operation_log`
        <where>
            <if test="adminName != null"> and admin_name like concat('%', #{adminName}, '%')</if>
            <if test="module != null and module != ''"> and module = #{module}</if>
        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.example.entity.OperationLog">
        select * from `operation_log` where id = #{id}
    </select>

    <delete id="deleteById">
        delete from `operation_log` where id = #{id}
    </delete>

    <delete id="deleteBatch">
        delete from `operation_log` where id in
        <foreach collection="list" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <insert id="insert" parameterType="com.example.entity.OperationLog" useGeneratedKeys="true">
        insert into `operation_log`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="adminId != null">admin_id,</if>
            <if test="adminName != null">admin_name,</if>
            <if test="module != null">module,</if>
            <if test="action != null">action,</if>
            <if test="target != null">target,</if>
            <if test="content != null">content,</if>
            <if test="ip != null">ip,</if>
            <if test="time != null">time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="adminId != null">#{adminId},</if>
            <if test="adminName != null">#{adminName},</if>
            <if test="module != null">#{module},</if>
            <if test="action != null">#{action},</if>
            <if test="target != null">#{target},</if>
            <if test="content != null">#{content},</if>
            <if test="ip != null">#{ip},</if>
            <if test="time != null">#{time},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.OperationLog">
        update `operation_log`
        <set>
            <if test="adminId != null">admin_id = #{adminId},</if>
            <if test="adminName != null">admin_name = #{adminName},</if>
            <if test="module != null">module = #{module},</if>
            <if test="action != null">action = #{action},</if>
            <if test="target != null">target = #{target},</if>
            <if test="content != null">content = #{content},</if>
            <if test="ip != null">ip = #{ip},</if>
            <if test="time != null">time = #{time},</if>
        </set>
        where id = #{id}
    </update>
</mapper>